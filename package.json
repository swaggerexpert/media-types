{
  "name": "@swaggerexpert/media-types",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": true
  },
  "version": "1.0.2",
  "description": "RFC 9110 media type and media range parser, validator and matcher.",
  "unpkg": "./dist/media-types.browser.min.js",
  "jsdelivr": "./dist/media-types.browser.min.js",
  "main": "./cjs/index.cjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./es/index.mjs"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./cjs/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./grammar.bnf": "./src/grammar.bnf"
  },
  "watch": {
    "test": "{src,test}/**/*.js"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "grammar:compile": "node ./scripts/apg-js.js --lite --in=./src/grammar.bnf --out=./src/grammar.js",
    "clean": "node -e \"const fs = require('node:fs'); for (const path of ['es', 'cjs', 'dist', 'types/index.d.cts']) fs.rmSync(path, { recursive: true, force: true });\"",
    "build": "npm run clean && npm run grammar:compile && npm run build:es && npm run build:cjs && npm run build:cjs:apg-lite && npm run build:types && npm run build:umd:browser",
    "build:es": "cross-env BABEL_ENV=es babel src --out-dir es --extensions '.js' --out-file-extension '.mjs'",
    "build:cjs": "cross-env BABEL_ENV=cjs babel src --out-dir cjs --extensions '.js' --out-file-extension '.cjs'",
    "build:cjs:apg-lite": "cross-env BABEL_ENV=cjs babel node_modules/apg-lite/lib/parser.js --out-file ./cjs/apg-lite.cjs",
    "build:types": "node -e \"require('node:fs').copyFileSync('types/index.d.ts', 'types/index.d.cts')\"",
    "build:umd:browser": "cross-env BABEL_ENV=browser webpack --config config/webpack/browser.config.js --progress && node -e \"require('node:fs').copyFileSync('config/webpack/dist-package.json', 'dist/package.json')\"",
    "test": "mocha",
    "test:artifacts": "node ./test/artifacts/smoke.cjs",
    "test:types": "tsc --noEmit --strict --skipLibCheck false --module node16 --moduleResolution node16 --target es2020 test/artifacts/types/consumer.cts test/artifacts/types/consumer.mts && tsc --noEmit --strict --module esnext --moduleResolution bundler --target es2020 test/artifacts/types/consumer.mts",
    "test:watch": "npm-watch test",
    "watch": "npm-watch"
  },
  "engines": {
    "node": ">=12.20.0"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/swaggerexpert/media-types.git"
  },
  "keywords": [
    "media-type",
    "media-range",
    "mime",
    "content-type",
    "accept",
    "content-negotiation",
    "parser",
    "validator",
    "matcher",
    "rfc9110",
    "rfc6838"
  ],
  "author": "Vladimír Gorej <vladimir.gorej@gmail.com>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/swaggerexpert/media-types/issues"
  },
  "homepage": "https://github.com/swaggerexpert/media-types#readme",
  "files": [
    "es/",
    "cjs/",
    "dist/",
    "types/",
    "src/grammar.bnf",
    "LICENSE",
    "NOTICE",
    "package.json",
    "README.md",
    "SECURITY.md"
  ],
  "dependencies": {
    "apg-lite": "^1.0.6"
  },
  "devDependencies": {
    "@babel/cli": "=8.0.6",
    "@babel/core": "=8.0.7",
    "@babel/preset-env": "=8.0.7",
    "@commitlint/cli": "=21.2.4",
    "@commitlint/config-conventional": "=21.2.4",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/npm": "^13.1.3",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "apg-js": "^4.4.0",
    "babel-loader": "^10.0.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "chai": "=6.3.0",
    "cross-env": "^10.1.0",
    "husky": "=9.1.7",
    "mocha": "=12.0.3",
    "npm-watch": "^0.13.0",
    "prettier": "^3.5.2",
    "semantic-release": "^25.0.2",
    "terser-webpack-plugin": "^5.3.14",
    "typescript": "^7.0.2",
    "webpack": "^5.98.0",
    "webpack-cli": "^7.2.1"
  }
}
